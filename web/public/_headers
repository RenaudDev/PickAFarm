# Cache static map image aggressively
/us-map-static.png
  Cache-Control: public, max-age=31536000, immutable
  
# Cache all images for 1 year
/*.png
  Cache-Control: public, max-age=31536000, immutable
  
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  
/*.webp
  Cache-Control: public, max-age=31536000, immutable
  
/*.avif
  Cache-Control: public, max-age=31536000, immutable

# Cache fonts for 1 year
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Cache JavaScript/CSS for 1 year (with hash in filename)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
