# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to Git!

# API URL - Cloudflare Worker API endpoint
NEXT_PUBLIC_API_URL=https://pickafarm-api.94623956quebecinc.workers.dev

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# CDN Configuration (for farm images from R2)
NEXT_PUBLIC_CDN_URL=https://cdn.pickafarm.com
# Development fallback: https://pub-326783be0962429fb08c8a70c6b02503.r2.dev
